# Copia este archivo a .env.local para desarrollo. En Vercel, crea las mismas variables en
# Settings → Environment Variables. Nunca subas claves reales al repositorio.

# Supabase (Project Settings → API). La clave publicable es segura en el navegador: RLS protege los datos.
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Tests de base de datos (Postgres 16 local o el de CI)
TEST_DATABASE_URL=postgres://postgres@localhost:54329/postgres
